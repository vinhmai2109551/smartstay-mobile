# Copy file này thành .env rồi điền giá trị thật vào.
# .env đã bị gitignore — không commit giá trị thật.

# URL gốc của backend NestJS, PHẢI kèm tiền tố /api/v1 (backend dùng
# app.setGlobalPrefix('api/v1')).
# - Giả lập Android (Android Studio), backend chạy trên cùng máy: http://10.0.2.2:3000/api/v1
# - Expo Go / dev client trên điện thoại thật: http://<IP-LAN-may-ban>:3000/api/v1
#   (điện thoại và máy tính phải cùng mạng Wi-Fi; localhost sẽ KHÔNG hoạt động)
# - Giả lập iOS / web: http://localhost:3000/api/v1 dùng được
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google OAuth Web Client ID — dùng cho nút "Đăng nhập với Google" (POST /auth/google).
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# (chọn loại "Web application", vì expo-auth-session thực hiện luồng OAuth qua
# browser rồi đổi lấy id_token để backend xác minh).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth Client ID riêng cho từng nền tảng native (Google Cloud Console >
# Credentials > OAuth client ID, loại "iOS" dùng bundle id com.smartstay.app /
# loại "Android" dùng package com.smartstay.app). expo-auth-session cần các ID
# này trên từng nền tảng. Đăng nhập Google native chỉ hoạt động trong bản dev
# client/production, KHÔNG chạy được trên Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloudflare Turnstile site key (public) — giống hệt key web frontend dùng.
# Bắt buộc phải có cho widget đăng nhập bằng mật khẩu (xem TurnstileWidget.tsx);
# thiếu key này thì WebView render với sitekey rỗng và Turnstile sẽ không xác
# minh được.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Phải khớp với một hostname trong TURNSTILE_ALLOWED_HOSTNAMES của backend.
EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost
