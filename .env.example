# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real values.

# Base URL of the SmartStay NestJS backend, INCLUDING the /api/v1 prefix
# (backend uses app.setGlobalPrefix('api/v1') — see doc/API.md section 0.3).
# - Android emulator talking to a backend on the same PC: http://10.0.2.2:3000/api/v1
# - Expo Go on a physical device: http://<your-computer-LAN-IP>:3000/api/v1
# - iOS simulator / web: http://localhost:3000/api/v1 works fine
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google OAuth Web Client ID, used for "Đăng nhập với Google" (POST /auth/google).
# Get it from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# (use a "Web application" client, since expo-auth-session performs the OAuth
# flow in a browser and exchanges it for an id_token verified by the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Google OAuth client IDs (Google Cloud Console > Credentials > OAuth client ID,
# type "iOS" with bundle id com.smartstay.app / type "Android" with package com.smartstay.app).
# Required by expo-auth-session on each native platform. Native Google sign-in
# only works in a development/production build, NOT in Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Cloudflare Turnstile site key (public) — same one the web frontend uses.
# Required for the password login widget (see TurnstileWidget.tsx); without it
# the WebView renders with an empty sitekey and Turnstile fails to verify.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Must match one of the backend's TURNSTILE_ALLOWED_HOSTNAMES.
EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost
